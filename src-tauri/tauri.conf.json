{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "tpt-startup",
  "version": "0.1.0",
  "identifier": "com.tpt-solutions.tpt-startup",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "tpt-startup",
        "width": 1080,
        "height": 720,
        "minWidth": 720,
        "minHeight": 480,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "category": "Utility",
    "shortDescription": "Smart Startup & Background Service Manager",
    "longDescription": "Shows every program that starts at login or boot, with plain-English explanations and safe enable/disable/delete controls.",
    "publisher": "TPT Solutions",
    "license": "MIT OR Apache-2.0",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"]
  }
}
